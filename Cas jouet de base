coord_x = [clients[i][0][0] for i in range(len(clients))]
coord_y = [clients[i][0][1] for i in range(len(clients))]
plt.scatter(coord_x, coord_y, marker='o', label = 'Clients')
for i in range(1,len(clients)):
    plt.text(coord_x[i],coord_y[i],str(i))
plt.scatter(depot[0][0], depot[0][1], color = 'red', label = 'Depot')
X = [clients[i][0][0] for i in tournee_1]
Y = [clients[i][0][1] for i in tournee_1]
plt.plot(X, Y, label = 'Chemin', linewidth = 0.9, color = 'black')
X_best = [clients[i][0][0] for i in tournee_best]
Y_best = [clients[i][0][1] for i in tournee_best]
plt.plot(X_best, Y_best, label = 'Chemin amélioré', linewidth = 0.4, color = 'lightgreen')
plt.title(label = 'Représentation de la situation')
plt.legend()
plt.show()



# -------------------------- Fonction de vérification (pas d'utilité réelle)
def nb_vehicule(tournee):
    charge = 0
    K = 1
    for client in tournee:
        charge += clients[client][1]
        if charge > C:
            charge = clients[client][1]
            K += 1
    return K
print(nb_vehicule(tournee_1), nb_vehicule(tournee_best), nb_vehicule(tournee_test_best))